{
  "listen_addr": "127.0.0.1:9090",
  "keystone_issuer": "http://127.0.0.1:8080",
  "jwks_refresh_interval": 300000000000,
  "jwks_rotation_cooldown": 5000000000,
  "routes": [
    {
      "name": "public-api",
      "match": { "path_prefix": "/public" },
      "upstream": "http://127.0.0.1:8081",
      "protected": false
    },
    {
      "name": "protected-api",
      "match": { "path_prefix": "/api" },
      "upstream": "http://127.0.0.1:8082",
      "protected": true
    }
  ]
}
